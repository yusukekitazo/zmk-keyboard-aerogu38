/*
 * aerogu38 keymap — aerogu34 のキーマップを移植したもの。
 * 38で追加された4キー(左: Z/Xの下、右: ./の下)は全レイヤー &trans。
 * 位置番号: 左追加=30,31 / 左サム=32,33 / 右サム=34,35 / 右追加=36,37。
 */
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <mouse-gesture.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };

    combos {
        compatible = "zmk,combos";

        Bt {
            bindings = <&mo 6>;
            key-positions = <32 33>; // 38: 追加キー分、サムキーが+2ずれる
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        /* J+K 同時押し: SCROLLレイヤー */

        scroll {
            bindings = <&mo 5>;
            key-positions = <16 17>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        control {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <20 21>;
        };

        alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <21 22>;
        };

        gui {
            bindings = <&kp LEFT_GUI>;
            key-positions = <22 23>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <27 28>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <28 29>;
        };

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <26 27>;
        };

        /* ジェスチャー起動は「Lキー長押し」(下の gesture_l ホールドタップ)に
         * 変更したので、mouse_gesture_activate コンボは廃止。
         * 1キーだけのコンボ(key-positions = <18>)が残っているとLの入力を
         * コンボが横取りして、Lが打てなくなる。 */
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        /* Lキー: タップ=L、長押し=ジェスチャー認識ON。
         * 使い方: &gesture_l 0 L  (第1引数は未使用のダミー)
         * require-prior-idle-ms: 直前150ms以内に別キーを打っていたら
         * 必ずタップ扱い(高速タイプ中のLの誤ホールド防止)。 */

        gesture_l: gesture_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&mouse_gesture>, <&kp>;
        };
    };

    macros {
        Macmode: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&bt BT_SEL 1>,
                <&macro_wait_time 200>,
                <&macro_tap>,
                <&tog 0>;

            label = "NEW_MACRO";
        };

        app_switcher: app_switcher {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "APP_SWITCHER";
        };

        controlcenter: controlcenter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "CONTROLCENTER";
        };

        tuutincenter: tuutincenter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp N>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "TUUTINCENTER";
        };

        docs: docs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "DOCS";
        };

        applist: AppList {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp LS(A)>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "APPLIST";
        };

        homegamen: homegamen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp H>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "HOMEGAMEN";
        };

        slideover1: slideover1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp LA(LEFT_ARROW)>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "SLIDEOVER1";
        };

        slideover2: slideover2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp LA(RIGHT_ARROW)>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "SLIDEOVER2";
        };

        Quicknote: Quicknote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "QUICKNOTE";
        };

        windowsime: windowsime {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "WINDOWSIME";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
&kp Q        &kp W            &kp E  &kp R  &kp T  &kp Y        &kp U        &kp I      &kp O           &kp P
&kp A        &kp S            &kp D  &kp F  &kp G  &kp H        &kp J        &kp K      &gesture_l 0 L  &mt RIGHT_SHIFT MINUS
&kp Z        &kp X            &kp C  &kp V  &kp B  &kp N        &kp M        &kp COMMA  &kp DOT         &kp SLASH
&trans  &trans  &lt 2 SPACE  &lt 3 BACKSPACE       &lt 4 ENTER  &windowsime  &trans  &trans
            >;
        };

        MOUSE {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans
            >;
        };

        MARK1 {
            display-name = "Mark1";
            bindings = <
&kp EXCLAMATION  &kp AT         &kp HASH      &kp DOLLAR    &kp PERCENT          &kp CARET          &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp C_BRI_DN     &kp C_BRI_INC  &kp C_VOL_DN  &kp C_VOL_UP  &kp LA(PRINTSCREEN)  &kp UNDERSCORE     &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp TILDE
&kp LC(Z)        &kp LC(X)      &kp LC(C)     &kp LC(V)     &kp LS(A)            &kp DOUBLE_QUOTES  &kp COLON      &kp LS(COMMA)     &kp LS(PERIOD)        &kp LS(SLASH)
&trans  &trans  &trans  &mo 3                                                    &trans  &trans  &trans  &trans
            >;
        };

        NUM1 {
            display-name = "Num1";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp N0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5     &kp F6        &kp F7        &kp F8        &kp F9        &kp F12
&kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(A)  &kp INSERT    &kp LC(W)     &trans        &trans        &trans
&trans  &trans  &trans  &trans                                     &kp ESCAPE  &kp CAPS  &trans  &trans
            >;
        };

        CURSOR1 {
            display-name = "Cursor1";
            bindings = <
&kp LA(Q)      &kp LA(W)  &kp LEFT_GUI            &kp LA(TAB)              &kp LA(F4)  &kp LC(W)           &kp LC(T)            &kp UP_ARROW    &kp LS(LC(TAB))  &kp LC(TAB)
&kp LG(O)      &kp LG(W)  &kp LG(LC(LEFT_ARROW))  &kp LG(LC(RIGHT_ARROW))  &kp LA(E)   &kp F5              &kp LEFT_ARROW       &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LC(F)
&kp LG(SLASH)  &trans     &kp LG(N)               &kp LA(C)                &kp LA(R)   &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &kp LA(B)       &kp RG(A)        &kp LC(L)
&trans  &trans  &kp LA(S)  &kp LG(H)                                                   &trans  &trans  &trans  &trans
            >;
        };

        SCROLL {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &kp LEFT_SHIFT  &kp LCTRL  &trans      &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans          &trans     &kp RSHIFT  &trans  &trans  &trans  &kp RCTRL
&trans  &trans  &trans  &trans          &trans     &trans      &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans
            >;
        };

        WIRELESS {
            display-name = "Wireless";
            bindings = <
&bt BT_SEL 0  &Macmode  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans    &trans        &trans        &bootloader   &trans        &trans          &trans        &trans        &bt BT_CLR
&trans        &trans    &trans        &trans        &trans        &trans        &trans          &trans        &trans        &bt BT_CLR_ALL
&trans  &trans  &trans  &trans                                    &bootloader  &studio_unlock  &trans  &trans
            >;
        };
    };
};